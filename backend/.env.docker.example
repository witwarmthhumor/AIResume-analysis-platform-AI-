# 复制为 backend/.env.docker 后填写真实值；此文件不提交
POSTGRES_USER=ai
POSTGRES_PASSWORD=请替换为数据库强密码
POSTGRES_DB=ai_interview
DATABASE_URL=postgresql+psycopg://ai:请替换为数据库强密码@db:5432/ai_interview
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_URL=redis://redis:6379/1
UPLOAD_DIR=/data/uploads
JWT_SECRET_KEY=请替换为随机长字符串
JWT_EXPIRE_MINUTES=1440
JWT_SECURE_COOKIE=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=请填写模型Key
# 工具内部自己调模型的工具（JD 匹配 / 出题 / 回答点评）每人每日上限，
# 与 AI 客服提问上限（DAILY_AGENT_LIMIT）分开计；设 0 即关闭
DAILY_AGENT_TOOL_LLM_LIMIT=20
APP_ENV=prod
