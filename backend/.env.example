# 环境变量模板：复制一份改名 .env 再填真实值（.env 永不入库）
# 数据库连接串：协议用 postgresql+psycopg（SQLAlchemy 2 + 3代驱动）
DATABASE_URL=postgresql+psycopg://ai:ai@localhost:5432/ai_interview

# —— 阶段1：上传限制（默认值即 PROJECT-PLAN 定的 5MB/5页，一般不用改）——
# UPLOAD_MAX_SIZE=5242880
# UPLOAD_MAX_PAGES=5
# UPLOAD_DIR=uploads

# —— 阶段2 接入大模型（OpenAI 兼容协议；换模型 = 改下面三行）——
# 通义（阿里云百炼）：BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1，MODEL=qwen-plus
# DeepSeek：BASE_URL=https://api.deepseek.com/v1，MODEL=deepseek-chat
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_API_KEY=sk-xxxx

# —— 阶段2 可选调优（默认值即上线值）——
# AI_MAX_TOKENS=2000        # 单次输出上限，控成本
# AI_TIMEOUT_SECONDS=60
# DAILY_ANALYSIS_LIMIT=20   # 每人每日分析次数上限
