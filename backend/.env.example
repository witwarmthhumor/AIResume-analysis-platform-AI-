# 环境变量模板：复制一份改名 .env 再填真实值（.env 永不入库）
# 数据库连接串：协议用 postgresql+psycopg（SQLAlchemy 2 + 3代驱动）
DATABASE_URL=postgresql+psycopg://ai:ai@localhost:5432/ai_interview

# —— 阶段1：上传限制（默认值即 PROJECT-PLAN 定的 5MB/5页，一般不用改）——
# UPLOAD_MAX_SIZE=5242880
# UPLOAD_MAX_PAGES=5
# UPLOAD_DIR=uploads

# —— 阶段2 接入大模型时再取消注释 ——
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
# AI_API_KEY=sk-xxxx
