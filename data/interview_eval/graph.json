    "actions": [
      "start",
      "answer",
      "finish"
    ],
    "expect": {
      "final_status": "finished",
      "turn_count": 2,
      "report_present": true,
      "resume_count": 2
    }
  },
  {
    "id": "checkpoint_recovery",
    "title": "每轮请求重建图对象：续跑状态全部来自 PostgresSaver（崩溃恢复语义）",
    "actions": [
      "start",
      "answer"
    ],
    "expect": {
      "resume_count": 1,
      "turn_count": 2,
