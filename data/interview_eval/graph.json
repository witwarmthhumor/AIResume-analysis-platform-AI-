    }
  },
  {
    "id": "opening_idempotent",
    "title": "开场白幂等：完整流程跑完开场白只有一条",
    "actions": [
      "start",
      "answer",
      "finish"
    ],
    "expect": {
      "opening_count": 1,
      "final_status": "finished"
    }
  },
  {
    "id": "follow_up_on_weak_answer",
    "title": "弱回答触发面试官智能追问：追问不占轮次、追问后再答进入下一题（v4.5 面试官 Agent）",
